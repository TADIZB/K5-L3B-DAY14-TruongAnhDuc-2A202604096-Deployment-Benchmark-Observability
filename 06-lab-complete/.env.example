# ============================================================
# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore và .dockerignore)
# Trên Railway / Render: đặt các biến này trong dashboard của service.
# ============================================================

# Server
PORT=8000
# development | staging | production (production bắt buộc có AGENT_API_KEY)
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Security — BẮT BUỘC. Sinh key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# State store (rate limit + cost guard). docker-compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
